# K-Beauty Intelligence Agent v3 - 환경변수 설정

# LLM
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5-5
VALIDATOR_MODEL=claude-opus-5-5   # LLM 판정 검증 모델 (생성 모델과 다르게)
VOC_MODEL=claude-haiku-5-5        # 리뷰 감성 분석·키워드 추출

# 수집
YOUTUBE_API_KEY=your_youtube_api_key
APIFY_TOKEN=your_apify_token      # TikTok 수집 (Apify)

# 경로
DB_PATH=db/kbeauty.db

# 선택: 수집량 조절 (값은 기본값)
# TIKTOK_GENERIC_ITEMS=60         # 일반 해시태그당 TikTok 영상 수
# TIKTOK_BRAND_ITEMS=5            # 브랜드 해시태그당 TikTok 영상 수
# DEEP_COLLECT=1                  # 0 이면 트렌드 후보 심층 수집 끔
# DEEP_YT_PAGES=2                 # 심층 수집 YouTube 페이지 수 (페이지당 50)
# DEEP_TT_ITEMS=28                # 심층 수집 TikTok 영상 수
# OY_CATALOG_POOL_SIZE=3          # 카탈로그 수집 동시 페이지 수

# 선택: 운영 (Airflow)
# REPORT_S3_BUCKET=               # 설정하면 주간 HTML 리포트를 S3 에 올림
# SLACK_WEBHOOK_URL=              # 설정하면 실패 알림을 Slack 으로 보냄
