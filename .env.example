# K-Beauty Intelligence Agent v3 - 환경변수 설정

# LLM
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5-5
VALIDATOR_MODEL=claude-opus-5-5   # LLM 판정 검증 모델 (생성 모델과 다르게)
VOC_MODEL=claude-haiku-5-5        # 리뷰 감성 분석·키워드 추출

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key

# 경로
DB_PATH=db/kbeauty.db
DATA_DIR=data
EXPORT_DIR=exports

# 에이전트 파라미터
TOP_TRENDS_N=30
MIN_ENGAGEMENT=50
AGENT_RUN_HOUR=9
